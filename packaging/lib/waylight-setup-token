#!/bin/sh
# Shows the one-time setup token of this waylight installation and where
# to open it. Needs root: the token is readable by root and the service only.
set -eu

if [ "$(id -u)" -ne 0 ]; then
	echo "Run with sudo: sudo waylight-setup-token" >&2
	exit 1
fi

# shellcheck source=packaging/lib/env.sh
. "${WAYLIGHT_LIB:-/usr/lib/waylight}/env.sh"

suffix=$(waylight_url_suffix)
status=$(waylight_setup_status)
case "$status" in
done)
	echo "waylight is already set up; the setup token is no longer valid."
	echo "Forgot the password? See https://github.com/Waylight-App/waylight/blob/main/docs/native-install.md"
	;;
*)
	token=$(waylight_value SETUP_TOKEN)
	if [ -z "$token" ]; then
		echo "No setup token yet: start the service first (sudo systemctl start waylight)." >&2
		exit 1
	fi
	echo "Open   http://$(hostname).local$suffix  (or http://<ip-address>$suffix)"
	echo "Token  $token"
	[ "$status" = pending ] || echo "(The service is not reachable right now: sudo systemctl status waylight)"
	;;
esac
