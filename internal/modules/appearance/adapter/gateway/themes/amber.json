{
  "id": "amber",
  "name": "Amber",
  "author": "trisse-home (MIT)",
  "tokens": {
    "--font-sans": "figtree",
    "--font-display": "fraunces",
    "--radius": "14px",
    "--radius-small": "10px",
    "--color-accent": "#f2b441",
    "--color-accent-contrast": "#1a1206"
  },
  "variants": {
    "light": {
      "--color-bg": "#fff3d6",
