# Applies the display mode the app requests (#140). The app can only write
# /var/lib/waylight/device/display-mode; this root-owned unit reacts.
[Unit]
Description=Display mode requests of waylight

[Path]
PathChanged=/var/lib/waylight/device/display-mode
Unit=waylight-display.service

[Install]
WantedBy=multi-user.target
